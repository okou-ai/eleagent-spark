# Copy to a private .env file on each host. Addresses are private IPv4 values.
# Keep shared credentials and addresses identical across the two copies.
SPARK1_ADDRESS=
SPARK2_ADDRESS=
DATA_ROOT=/srv/eleagent/data
MODEL_ROOT=/srv/eleagent/models
ELEAGENT_TIMEZONE=America/Los_Angeles
# Quote values containing spaces so this file can also be loaded by a shell.
ELEAGENT_OWNER_NAME='Me'

# Internal service credentials only; never distribute to browser/MCP users.
# Generate independent random values; never commit the populated file.
SCENE_API_TOKEN=
SCENE_ARCHIVE_TOKEN=
# Explicit canonical origin, e.g. https://memory.example.com. No paths or trailing slash.
# Changing it changes the OAuth issuer/resource; clients must reconnect.
AUTH_PUBLIC_URL=
# The owner chooses their email with init-owner.mjs --email; public signup is disabled.
# Internal observer transport. HTTPS backends require explicit trusted CA configuration.
OBSERVER_URL=http://127.0.0.1:8080
OBSERVER_CA_FILE=
OBSERVER_CA_HOST_FILE=/dev/null
# Create DATA_ROOT/auth/secret privately (>=32 random characters), UID 1000, mode 0600.
# OAuth state is persisted in DATA_ROOT/auth/auth.sqlite; do not commit either file.
# Optional additional exact browser origins for /mcp; the canonical public origin is always allowed.
MCP_ALLOWED_ORIGINS=
NEO4J_PASSWORD=

# Built separately with deploy/minicpm/build.sh from the pinned public base.
MINICPM_IMAGE=local/eleagent-minicpm:production

# Optional local dependency cache; defaults keep the public source build.
# See docs/agent-runbook.md before enabling installed PyTorch reuse.
RECOGNITION_BASE_IMAGE=python:3.12-slim
REUSE_INSTALLED_TORCH=0

# 100 GiB free-space reserve; reduce only to suit the actual storage allocation.
ARCHIVE_RESERVE_BYTES=107374182400
# Leave unset for automatic ASR language detection, or use a language name.
ASR_LANGUAGE=

# Spark 2's local VLM (vlm service): its weights directory under MODEL_ROOT, and the vLLM image (a local mirror of
# the same tag avoids a pull). Naming and the day agent call it by the served model name.
VLM_MODEL_DIR=qwen3.6-35b-a3b-fp8
VLM_IMAGE=nvcr.io/nvidia/vllm:26.09-py3
NAMING_VLM_MODEL=qwen3.6-35b-a3b

# The day agent on Spark 2 gets Okou access tokens from graph-api's internal listener: the Spark 1 address on the
# direct Spark link plus a port, e.g. 10.100.24.1:22404. Shared secret files: see docs/agent-runbook.md.
AGENT_INTERNAL_ADDR=
